# ============================================
# Dockerfile for Client App (React + Vite)
# Multi-stage: build then serve with nginx
# ============================================

# --- Stage 1: Build ---
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY Client/package.json Client/package-lock.json ./

# Install all dependencies (including devDependencies for build)
RUN npm ci --legacy-peer-deps

# Copy source code
COPY Client/ ./

# Set environment variables for build
# CLIENT_PUBLIC_URL controls asset paths and React Router basename.
# Example: /chair-demo (no trailing slash)
ARG CLIENT_PUBLIC_URL=/app
ARG REACT_APP_API_BASE_URL=
ENV REACT_APP_API_URL=${REACT_APP_API_BASE_URL}
ENV REACT_APP_API_BASE_URL=${REACT_APP_API_BASE_URL}
ENV REACT_APP_BASE_PATH=${CLIENT_PUBLIC_URL}
ENV PUBLIC_URL=${CLIENT_PUBLIC_URL}

# Build the React app via Vite
RUN npm run build

# --- Stage 2: Serve with nginx ---
FROM nginx:alpine

# Copy custom nginx config for SPA routing
COPY production-build/nginx-client.conf /etc/nginx/conf.d/default.conf

# Copy build output (Vite builds to dist)
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
