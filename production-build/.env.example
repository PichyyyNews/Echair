# ============================================
#  Echair Production Environment Variables
#  Copy this file to .env and fill in values
#  Usage: copy .env.example .env
# ============================================

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me_to_secure_password

# MongoDB connection string
MONGODB_URI=mongodb://admin:change_me_to_secure_password@mongodb:27017/myreactdb?authSource=admin

# --- Redis (Caching & Job Queue) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO / S3 Object Storage (Self-Hosted Free) ---
MINIO_ROOT_USER=echair_admin
MINIO_ROOT_PASSWORD=change_me_secure
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=echair-uploads

# --- Server ---
JWT_SECRET=change_me_to_random_secret_string
NODE_ENV=production

# --- Error Tracking (Optional) ---
SENTRY_DSN=

# --- Email (for password reset & verification) ---
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# --- Client Path Prefix ---
# Example: /chair-demo (no trailing slash)
CLIENT_PUBLIC_URL=/app

# --- Client URL (used in email templates) ---
# Must include the same prefix as CLIENT_PUBLIC_URL
CLIENT_URL=http://localhost/app

# Optional: override API base path/origin used at build time.
# Leave empty to reuse CLIENT_PUBLIC_URL automatically.
REACT_APP_API_BASE_URL=

# --- Firebase ---
# Path to the Firebase Service Account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# --- Nginx ---
# Port exposed on the host
NGINX_PORT=80
